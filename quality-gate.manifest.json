{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.1.0/schemas/schema.json",
  "services": [
    {
      "quality-gates": [
        {
          "check-types": ["code style and linting", "secret scanning"],
          "config": {
            "file": ".github/workflows/pr-check.yml",
            "name": "Run pre-commit",
            "path": "jobs.pre-commit"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "check-types": ["unit", "unit test coverage"],
          "config": {
            "file": ".github/workflows/pr-check.yml",
            "name": "Run tests",
            "path": "jobs.tests"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "check-types": ["accessibility", "integration", "regression"],
          "config": {
            "file": ".github/workflows/pr-check.yml",
            "name": "Run browser tests",
            "path": "jobs.browser-tests"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "check-types": ["code quality", "vulnerability detection"],
          "config": {
            "file": ".github/workflows/scan-repo.yml",
            "name": "Sonar scan",
            "path": "jobs.sonar"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        },
        {
          "check-types": ["code quality", "vulnerability detection"],
          "config": {
            "file": ".github/workflows/scan-repo.yml",
            "name": "CodeQL scan",
            "path": "jobs.codeql"
          },
          "phase": "pre-merge",
          "provider": "GitHub"
        }
      ],
      "service-tag": "ipv-cri-passport"
    }
  ]
}
