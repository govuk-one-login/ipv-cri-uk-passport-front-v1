{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.16.0/schemas/schema.json",
  "services": [
    {
      "product": "Passport-CRI",
      "component": "ipv-cri-uk-passport-front-v1",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checks.yml",
            "path": "$.jobs.pre-commit"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checks.yml",
            "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run lint']"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checks.yml",
            "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run test and write coverage']"
          },
          "checks": [
            {
              "name": "unit",
              "purpose": ["regression"]
            },
            {
              "name": "unit test coverage"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checks.yml",
            "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run CloudFormation tests']"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checks.yml",
            "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run browser tests']"
          },
          "checks": [
            {
              "name": "accessibility"
            },
            {
              "name": "integration",
              "purpose": ["regression"]
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checks.yml",
            "path": "$.jobs.run-premerge-checks.steps[?@.name=='Run sonarcloud scan']"
          },
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/codeql.yml",
            "path": "$.jobs.analyze"
          },
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/i18n.yml",
            "path": "$.jobs.check-i18n"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        }
      ]
    }
  ]
}
