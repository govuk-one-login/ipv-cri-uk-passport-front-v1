{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.13.0/schemas/schema.json",
  "services": [
    {
      "product": "Passport-CRI",
      "component": "Passport-CRI Front",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": ["code style and linting", "secret scanning"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checks.yml",
            "path": "$.jobs.pre-commit"
          }
        },
        {
          "checkTypes": [
            "accessibility",
            "code quality",
            "code style and linting",
            "integration",
            "regression",
            "unit",
            "unit test coverage",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checks.yml",
            "path": "$.jobs.run-premerge-checks"
          }
        },
        {
          "checkTypes": ["code quality", "vulnerability detection"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/codeql.yml",
            "path": "$.jobs.analyze"
          }
        },
        {
          "checkTypes": ["code style and linting"],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/i18n.yml",
            "path": "$.jobs.check-i18n"
          }
        }
      ]
    }
  ]
}
